# Local dev server port (matches PORT below and the "dev" script).
PORT=8106

# Local canonical URL. Replace with the deployed HTTPS origin in production.
APP_URL=http://localhost:8106

# Production requires durable storage and a unique authentication secret.
# Keep real values in your deployment secret manager, never in this file.
# DATABASE_URL=postgresql://user:password@db.example.invalid/nomad
# DATABASE_AUTH_TOKEN=<only-if-your-database-provider-requires-one>
# BETTER_AUTH_SECRET=<generate-with-openssl-rand-base64-32>
# A2A_SECRET=<generate-with-openssl-rand-hex-32>
